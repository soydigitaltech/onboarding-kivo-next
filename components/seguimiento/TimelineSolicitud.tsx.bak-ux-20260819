export default function TimelineSolicitud() {
  const containerRef = useRef<HTMLDivElement>(null);

  useGSAP(
    () => {
      const mm = gsap.matchMedia();

      mm.add("(prefers-reduced-motion: no-preference)", () => {
        const items =
          gsap.utils.toArray<HTMLElement>(".timeline-item");

        const currentIndex = PASOS.findIndex(
          (paso) => paso.estado === "actual",
        );

        const progress =
          currentIndex >= 0
            ? currentIndex / Math.max(PASOS.length - 1, 1)
            : 0;

        /*
         * Línea principal.
         * Se dibuja desde arriba hasta el estado actual.
         */
        gsap.fromTo(
          ".timeline-progress",
          {
            scaleY: 0,
          },
          {
            scaleY: progress,
            ease: "none",
            scrollTrigger: {
              trigger: containerRef.current,
              start: "top 72%",
              end: "bottom 78%",
              scrub: 0.8,
            },
          },
        );

        /*
         * Entrada de cada etapa.
         * Sin movimientos laterales.
         */
        items.forEach((item) => {
          const card =
            item.querySelector<HTMLElement>(".timeline-card");

          const node =
            item.querySelector<HTMLElement>(".timeline-node");

          const chips =
            item.querySelectorAll<HTMLElement>(".timeline-chip");

          const check =
            item.querySelector<HTMLElement>(".timeline-check");

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: item,
              start: "top 86%",
              once: true,
            },
          });

          tl.fromTo(
            node,
            {
              opacity: 0,
              scale: 0.78,
            },
            {
              opacity: 1,
              scale: 1,
              duration: 0.32,
              ease: "power2.out",
            },
          );

          tl.fromTo(
            card,
            {
              opacity: 0,
              y: 14,
            },
            {
              opacity: 1,
              y: 0,
              duration: 0.42,
              ease: "power2.out",
            },
            "-=0.18",
          );

          if (check) {
            tl.fromTo(
              check,
              {
                opacity: 0,
                scale: 0.45,
              },
              {
                opacity: 1,
                scale: 1,
                duration: 0.24,
                ease: "power2.out",
              },
              "-=0.18",
            );
          }

          if (chips.length > 0) {
            tl.fromTo(
              chips,
              {
                opacity: 0,
                y: 5,
              },
              {
                opacity: 1,
                y: 0,
                stagger: 0.045,
                duration: 0.24,
                ease: "power2.out",
              },
              "-=0.12",
            );
          }
        });

        /*
         * Estado actual.
         * Un solo pulso al aparecer.
         */
        const currentItem =
          containerRef.current?.querySelector<HTMLElement>(
            ".timeline-item[data-current='true']",
          );

        if (currentItem) {
          const currentNode =
            currentItem.querySelector<HTMLElement>(
              ".timeline-current-node",
            );

          const currentRing =
            currentItem.querySelector<HTMLElement>(
              ".timeline-current-ring",
            );

          if (currentNode) {
            gsap.fromTo(
              currentNode,
              {
                scale: 1,
              },
              {
                scale: 1.12,
                duration: 0.32,
                ease: "power2.out",
                repeat: 1,
                yoyo: true,
                scrollTrigger: {
                  trigger: currentItem,
                  start: "top 82%",
                  once: true,
                },
              },
            );
          }

          if (currentRing) {
            gsap.fromTo(
              currentRing,
              {
                opacity: 0,
                scale: 0.8,
              },
              {
                opacity: 1,
                scale: 1.45,
                duration: 0.75,
                ease: "power2.out",
                scrollTrigger: {
                  trigger: currentItem,
                  start: "top 82%",
                  once: true,
                },
              },
            );
          }
        }
      });

      return () => mm.revert();
    },
    {
      scope: containerRef,
    },
  );

  return (
    <section
      ref={containerRef}
      className="overflow-hidden rounded-[26px] border border-[#E9F0F6] bg-white"
    >
      <div className="px-5 pt-5 sm:px-6 sm:pt-6">
        <p className="text-xs font-extrabold uppercase tracking-[0.1em] text-primary">
          Tu recorrido
        </p>

        <div className="mt-1 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <h2 className="text-2xl font-extrabold tracking-tight text-ink">
              Así avanza tu solicitud
            </h2>

            <p className="mt-2 max-w-2xl text-sm leading-6 text-[#6A7F94]">
              Aquí puedes revisar todo lo que completaste desde el inicio y
              conocer los próximos pasos de tu solicitud.
            </p>
          </div>

          <div className="flex shrink-0 items-center gap-3">
            <div className="rounded-full bg-ink px-4 py-2 text-[12px] font-extrabold text-white">
              10 de 13 etapas
            </div>

            <div className="rounded-full bg-surface-blue px-4 py-2 text-[12px] font-extrabold text-primary-dark">
              En evaluación
            </div>
          </div>
        </div>
      </div>

      <div className="px-5 pb-9 pt-9 sm:px-6">
        <div className="relative">
          {/* Ruta base */}
          <span
            aria-hidden="true"
            className="absolute bottom-5 left-[19px] top-5 w-[3px] rounded-full bg-border lg:left-1/2 lg:-translate-x-1/2"
          />

          {/* Ruta recorrida */}
          <span
            aria-hidden="true"
            className="timeline-progress absolute bottom-5 left-[19px] top-5 w-[3px] origin-top rounded-full bg-sky lg:left-1/2 lg:-translate-x-1/2"
          />

          <ol className="relative flex flex-col gap-7 lg:gap-2">
            {PASOS.map((paso, index) => {
              const completado = paso.estado === "completado";
              const actual = paso.estado === "actual";
              const izquierda = index % 2 === 0;

              return (
                <li
                  key={`${paso.grupo}-${paso.numero}-${paso.titulo}`}
                  data-current={actual ? "true" : "false"}
                  className="timeline-item relative grid min-h-[138px] grid-cols-[40px_minmax(0,1fr)] gap-4 lg:grid-cols-[1fr_70px_1fr] lg:gap-0"
                >
                  {/* CARD IZQUIERDA */}
                  <div className="hidden lg:flex lg:items-center lg:justify-end lg:pr-7">
                    {izquierda ? <PasoCard paso={paso} /> : null}
                  </div>

                  {/* NODO CENTRAL */}
                  <div className="relative z-10 flex justify-center lg:col-start-2">
                    <div className="relative">
                      {actual ? (
                        <span
                          aria-hidden="true"
                          className="timeline-current-ring pointer-events-none absolute -inset-2 rounded-full border border-sky/40 opacity-0"
                        />
                      ) : null}

                      <span
                        className={`timeline-node ${
                          actual ? "timeline-current-node" : ""
                        } relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-extrabold ${
                          completado
                            ? "border-2 border-sky bg-ink text-white"
                            : actual
                              ? "border-2 border-sky bg-ink text-white"
                              : "border-[3px] border-border bg-white text-placeholder"
                        }`}
                      >
                        {completado ? (
                          <Check
                            className="timeline-check h-5 w-5"
                            strokeWidth={2.6}
                          />
                        ) : (
                          paso.numero
                        )}
                      </span>
                    </div>
                  </div>

                  {/* CARD DERECHA / MOBILE */}
                  <div className="min-w-0 lg:flex lg:items-center lg:pl-7">
                    <div className="lg:hidden">
                      <PasoCard paso={paso} />
                    </div>

                    {!izquierda ? (
                      <div className="hidden w-full lg:block">
                        <PasoCard paso={paso} />
                      </div>
                    ) : null}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </div>
    </section>
  );
}

function PasoCard({ paso }: { paso: PasoTimeline }) {
  const completado = paso.estado === "completado";
  const actual = paso.estado === "actual";

  return (
    <article
      className={`timeline-card w-full max-w-[440px] rounded-[20px] border p-4 sm:p-5 ${
        actual
          ? "border-sky bg-surface-blue"
          : completado
            ? "border-[#E5EEF3] bg-white"
            : "border-[#EDF2F5] bg-[#FAFBFC]"
      }`}
    >
      <div className="flex flex-wrap items-center justify-between gap-2">
        <span
          className={`inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-[0.08em] ${
            actual
              ? "text-primary-dark"
              : completado
                ? "text-ink-soft"
                : "text-placeholder"
          }`}
        >
          {paso.grupo === "usuario" ? (
            <UserRound className="h-3.5 w-3.5" strokeWidth={2.2} />
          ) : (
            <Landmark className="h-3.5 w-3.5" strokeWidth={2.2} />
          )}

          {paso.grupo === "usuario" ? "Completado por ti" : "Proceso Kivo"}
        </span>

        <span
          className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-extrabold ${
            actual
              ? "bg-ink text-white"
              : completado
                ? "bg-[#F3F6F8] text-ink-soft"
                : "bg-white text-placeholder"
          }`}
        >
          {completado ? (
            <FileCheck2 className="h-3 w-3" strokeWidth={2.4} />
          ) : actual ? (
            <Clock4 className="h-3 w-3" strokeWidth={2.4} />
          ) : null}

          {completado ? "Completado" : actual ? "Actual" : "Pendiente"}
        </span>
      </div>

      <div className="mt-3 flex items-baseline gap-2">
        <span
          className={`text-[11px] font-extrabold ${
            actual
              ? "text-primary-dark"
              : completado
                ? "text-muted"
                : "text-placeholder"
          }`}
        >
          {String(paso.numero).padStart(2, "0")}
        </span>

        <h3
          className={`text-[16px] font-extrabold tracking-tight ${
            paso.estado === "pendiente" ? "text-[#8393A1]" : "text-ink"
          }`}
        >
          {paso.titulo}
        </h3>
      </div>

      <p
        className={`mt-1.5 text-[12.5px] leading-5 ${
          paso.estado === "pendiente" ? "text-placeholder" : "text-muted"
        }`}
      >
        {paso.descripcion}
      </p>

      {paso.datos?.length ? (
        <div className="mt-4 flex flex-wrap gap-2">
          {paso.datos.map((dato) => (
            <span
              key={dato}
              className={`timeline-chip rounded-full px-3 py-1.5 text-[10.5px] font-bold ${
                actual
                  ? "bg-white text-primary-dark"
                  : "bg-[#F5F7FA] text-ink-soft"
              }`}
            >
              {dato}
            </span>
          ))}
        </div>
      ) : null}
    </article>
  );
}
